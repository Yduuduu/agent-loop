# LLM (Google Gemini)
GOOGLE_API_KEY=

# DB — 로컬은 SQLite, 운영은 Postgres URL로 교체 (앱 코드에 SQLite 전용 문법 금지)
DATABASE_URL=sqlite+aiosqlite:///./agentops.db

# 벡터 스토어
CHROMA_PERSIST_DIR=./data/chroma

# 업로드 파일(환불 증빙 이미지) 로컬 저장 경로
UPLOAD_DIR=./data/uploads

# 지식베이스 원본 PDF 저장 경로
POLICY_DOCS_DIR=./data/policy_docs

# 관측성 (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
